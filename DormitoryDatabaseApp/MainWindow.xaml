<Window x:Class="DormitoryDatabaseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление базой данных общежитий"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="8"
                Background="#EEF2FF"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Выберите таблицу:"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="TablesComboBox"
                          Width="280"
                          Height="32"
                          SelectionChanged="TablesComboBox_SelectionChanged"/>

                <Button Content="Обновить"
                        Width="120"
                        Height="32"
                        Margin="15,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="MainDataGrid"
                  Grid.Row="1"
                  Margin="0,15,0,15"
                  AutoGenerateColumns="True"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  FontSize="14"/>

        <Border Grid.Row="2"
                Padding="10"
                CornerRadius="8"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Добавить"
                        Width="140"
                        Height="38"
                        Margin="5"
                        Click="AddButton_Click"/>

                <Button Content="Обновить запись"
                        Width="160"
                        Height="38"
                        Margin="5"
                        Click="UpdateButton_Click"/>

                <Button Content="Удалить"
                        Width="140"
                        Height="38"
                        Margin="5"
                        Click="DeleteButton_Click"/>

                <Button Content="Получить значение по ID"
                        Width="190"
                        Height="38"
                        Margin="5"
                        Click="GetByIdButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>